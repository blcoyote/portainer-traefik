# Repository the runner registers with. Personal accounts only support repo-level runners, so use one
# runner stack per repository (change RUNNER_NAME and container_name if you run several).
RUNNER_REPO_URL=https://github.com/blcoyote/your-repo

# Fine-grained PAT scoped to that repository with "Administration: Read and write"
# (classic PAT: "repo" scope). Only used to obtain runner registration tokens.
RUNNER_ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional
RUNNER_NAME=portainer-runner
# Comma separated; workflows target the runner with runs-on: [self-hosted, portainer]
RUNNER_LABELS=portainer
TZ=Europe/Copenhagen
