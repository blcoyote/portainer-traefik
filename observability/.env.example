# ==============================================================================
# Grafana
# ==============================================================================

# Interface Grafana's port 3000 binds to. Default: localhost only.
# Set to the host's LAN IP (e.g. 192.168.0.10) or Tailscale IP. There is no Traefik route.
GRAFANA_BIND=127.0.0.1

# URL you open Grafana on; used in links Grafana generates.
GRAFANA_ROOT_URL=http://192.168.0.10:3000

GRAFANA_ADMIN_USER=admin
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# ==============================================================================
# Retention
# ==============================================================================

METRICS_RETENTION=90d
LOGS_RETENTION=30d
TRACES_RETENTION=30d
